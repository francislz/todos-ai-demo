{
  "name": "todos-ai-demo",
  "private": true,
  "description": "A tiny TODO monorepo used to demo an AI-assisted delivery workflow (GitHub Issues + Claude agents + Artifacts + scheduled tasks).",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @todos/web",
    "build": "npm run build -w @todos/web",
    "start": "npm run start -w @todos/web",
    "lint:check": "eslint . --max-warnings 0",
    "lint": "eslint . --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @todos/web",
    "check": "npm run lint:check && npm run format:check && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
